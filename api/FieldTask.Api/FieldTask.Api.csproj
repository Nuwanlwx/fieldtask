<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <!-- Include shared Domain source files located at ../Domain so they appear in Solution Explorer
       and are compiled into this project. Using Link places them under a virtual Domain folder. -->
  <ItemGroup>
    <Compile Include="..\Domain\**\*.cs">
      <Link>Domain\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
